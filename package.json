{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:cf": "node scripts/dev-cf.mjs",
    "dev:cf:smart": "node scripts/dev-cf-smart.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "textlint:verify": "node pretest-report-viewer/verify-text-playwright.mjs",
    "textlint:verify:headed": "node pretest-report-viewer/verify-text-playwright.mjs --headed=true",
    "textlint:verify:strict": "node pretest-report-viewer/verify-text-playwright.mjs --fail-on-warn=true",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:landing": "git checkout landing && pnpm run build:cf && wrangler deploy --env landing",
    "deploy:full": "git checkout full-featured && pnpm run build:cf && wrangler deploy --env full",
    "deploy:canary": "git checkout canary && pnpm run build:cf && wrangler deploy --env canary",
    "postinstall": "node scripts/stub-vercel-og.js"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.2.0-beta.1",
    "@neondatabase/serverless": "^1.0.2",
    "@opennextjs/cloudflare": "^1.17.1",
    "@tanstack/react-query": "^5.91.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.59.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4.67.0"
  }
}
